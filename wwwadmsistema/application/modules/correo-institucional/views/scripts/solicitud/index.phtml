            <tbody>
                <?php if (isset($this->solicitudes) && count($this->solicitudes) > 0): ?>
                    <?php foreach ($this->solicitudes as $sol): ?>
                    <tr>
                        <td><strong>#<?php echo $this->escape($sol->id_solicitud); ?></strong></td>
                        <td><code><?php echo $this->escape($sol->rut_solicitante); ?></code></td>
                        <td><?php echo $this->escape($sol->nombre_solicitante); ?></td>
                        <td><span class="etiqueta-contrato"><?php echo $this->escape($sol->tipo_contrato); ?></span></td>
                        <td><span class="correo-texto"><?php echo $this->escape($sol->correo_sugerido); ?></span></td>
                        <td>
                            <span class="estado estado-<?php echo htmlspecialchars($sol->estado_solicitud); ?>">
                                <?php echo $this->escape($sol->estado_solicitud); ?>
                            </span>
                        </td>
                        <td>
                            <!-- BOTÓN REPETIDO EN LA LISTA: Usa CLASE (.btnVerSolicitud) y atributos data-* -->
                            <button type="button" class="btnVerSolicitud boton-accion"
                                    style="background:#17a2b8;"
                                    data-id="<?php echo $sol->id_solicitud; ?>"
                                    data-rut="<?php echo $this->escape($sol->rut_solicitante); ?>"
                                    data-nombre="<?php echo $this->escape($sol->nombre_solicitante); ?>"
                                    data-correo="<?php echo $this->escape($sol->correo_sugerido); ?>">
                                👁️ .btnVerSolicitud
                            </button>
                        </td>
                    </tr>
                    <?php endforeach; ?>
                <?php else: ?>
                    <tr>
                        <td colspan="7" class="mensaje-vacio">No existen registros en solicitudes_correo.</td>
                    </tr>
                <?php endif; ?>
            </tbody>

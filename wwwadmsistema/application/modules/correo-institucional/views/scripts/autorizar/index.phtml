            <input type="text" id="motivoRechazoTexto" class="input-motivo" style="width:100%; margin-top:5px; box-sizing:border-box; padding:8px;" placeholder="Ej: Falta firma de convenio_TEST">
        </div>
        <div style="text-align:right; gap:10px; display:flex; justify-content:flex-end;">
            <button type="button" id="btnCancelarRechazo" class="boton-accion" style="background:#6c757d;">Cancelar</button>
            <button type="button" id="btnConfirmarRechazo" class="boton-accion boton-rechazar">Confirmar Rechazo</button>
        </div>
    </div>
</div>


<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Panel de Autorización - Aprendizaje MVC</title>
    <link rel="stylesheet" href="<?php echo $this->baseUrl('/css/estilos.css'); ?>">
</head>
<body>
<div class="contenedor-principal">
    <header class="encabezado-modulo">
        <h1>🔐 Panel de Autorización de Correos (APRENDIZAJE_MVC)</h1>
        <p class="subtitulo">Flujo demostrado: <code>autorizar/index.js</code> ➔ <code>AutorizarController.php</code> ➔ <code>exportarExcelAction()</code> / <code>aprobarAction()</code></p>
    </header>

    <!-- Resumen Superior de Estados -->
    <section class="tarjetas-resumen">
        <div class="tarjeta tarjeta-pendiente">
            <h3>⏳ Pendientes</h3>
            <span class="valor-metrica"><?php echo (int)$this->totalPendientes; ?></span>
        </div>
        <div class="tarjeta tarjeta-aprobada">
            <h3>✅ Aprobadas</h3>
            <span class="valor-metrica"><?php echo (int)$this->totalAprobadas; ?></span>
        </div>
        <div class="tarjeta tarjeta-rechazada">
            <h3>❌ Rechazadas</h3>
            <span class="valor-metrica"><?php echo (int)$this->totalRechazadas; ?></span>
        </div>
    </section>

    <!-- Navegación y Acciones Globales -->
    <div class="barra-acciones">
        <nav class="barra-navegacion">
            <a href="<?php echo $this->url(array('module'=>'correo-institucional', 'controller'=>'solicitud', 'action'=>'index'), 'default', true); ?>" class="enlace-nav">Formulario Solicitud</a>
            <a href="<?php echo $this->url(array('module'=>'correo-institucional', 'controller'=>'autorizar', 'action'=>'index'), 'default', true); ?>" class="enlace-nav activo">Módulo Autorización</a>
        </nav>
        <div class="acciones-derecha">
            <!-- BOTÓN ÚNICO CON ID: #btnExportarExcel -->
            <button type="button" id="btnExportarExcel" class="boton-excel" style="border:none; cursor:pointer;">
                📊 #btnExportarExcel
            </button>
        </div>
    </div>

    <!-- Filtro Asíncrono con JavaScript -->
    <section class="seccion-filtro">
        <label for="filtroEstado"><strong>Filtrar vista por estado (con <code>$(document).on('change', '#filtroEstado')</code>):</strong></label>
        <select id="filtroEstado" class="select-filtro">
            <option value="pendiente" selected>Solicitudes Pendientes</option>
            <option value="aprobada">Solicitudes Aprobadas</option>
            <option value="rechazada">Solicitudes Rechazadas</option>
        </select>
        <span id="indicador-carga-ajax" style="display:none; margin-left:10px; color:#0056b3; font-weight:bold;">Cargando solicitudes...</span>
    </section>

    <!-- Tabla Principal de Solicitudes y Acciones -->
    <section class="seccion-listado">
        <h2>Solicitudes Pendientes de Revisión</h2>
        <table class="tabla-datos" id="tabla-autorizar-DEMO">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>RUT</th>
                    <th>Nombre Solicitante</th>
                    <th>Tipo Contrato</th>
                    <th>Correo Propuesto</th>
                    <th>Acciones (.btnAprobarSolicitud / .btnRechazarSolicitud)</th>
                </tr>
            </thead>
            <tbody>
                <?php if (isset($this->pendientes) && count($this->pendientes) > 0): ?>
                    <?php foreach ($this->pendientes as $sol): ?>
                    <tr id="fila-solicitud-<?php echo $sol->id_solicitud; ?>">
                        <td><strong>#<?php echo $this->escape($sol->id_solicitud); ?></strong></td>
                        <td><code><?php echo $this->escape($sol->rut_solicitante); ?></code></td>
                        <td><?php echo $this->escape($sol->nombre_solicitante); ?></td>
                        <td><span class="etiqueta-contrato"><?php echo $this->escape($sol->tipo_contrato); ?></span></td>
                        <td><span class="correo-texto"><?php echo $this->escape($sol->correo_sugerido); ?></span></td>
                        <td class="columna-acciones">
                            <!-- BOTÓN REPETIDO: Usa CLASE (.btnAprobarSolicitud) y data-id -->
                            <button type="button" class="btnAprobarSolicitud boton-accion boton-aprobar"
                                    data-id="<?php echo (int)$sol->id_solicitud; ?>"
                                    data-nombre="<?php echo $this->escape($sol->nombre_solicitante); ?>">
                                ✅ .btnAprobarSolicitud
                            </button>

                            <!-- BOTÓN REPETIDO: Usa CLASE (.btnRechazarSolicitud) y data-id -->
                            <button type="button" class="btnRechazarSolicitud boton-accion boton-rechazar"
                                    data-id="<?php echo (int)$sol->id_solicitud; ?>"
                                    data-nombre="<?php echo $this->escape($sol->nombre_solicitante); ?>">
                                ❌ .btnRechazarSolicitud
                            </button>
                        </td>
                    </tr>
                    <?php endforeach; ?>
                <?php else: ?>
                    <tr>
                        <td colspan="6" class="mensaje-vacio">No hay solicitudes pendientes en este momento.</td>
                    </tr>
                <?php endif; ?>
            </tbody>
        </table>
    </section>
</div>

<!-- Modal para ingresar motivo de rechazo (utilizado por .btnRechazarSolicitud) -->
<div id="modalRechazo" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:9999; justify-content:center; align-items:center;">
